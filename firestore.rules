rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function member(m){return signedIn() && m is list && request.auth.uid in m;}
  function acceptedPair(id){
   return existsAfter(/databases/$(database)/documents/friendRequests/$(id))
    && getAfter(/databases/$(database)/documents/friendRequests/$(id)).data.status == 'accepted';
  }
  match /users/{uid}{
   allow get: if signedIn();
   allow list: if false;
   allow create: if signedIn() && request.auth.uid==uid
    && request.resource.data.keys().hasOnly(['uid','displayName','username','phoneVerified','createdAt'])
    && request.resource.data.uid==uid && request.resource.data.displayName is string
    && request.resource.data.displayName.size()>=2
    && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
    && request.resource.data.phoneVerified is bool;
   allow update: if signedIn() && request.auth.uid==uid
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
   allow delete: if false;
  }
  match /usernames/{name}{
   allow get: if signedIn(); allow list: if false;
   allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid'])
    && request.resource.data.uid==request.auth.uid
    && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));
   allow update,delete: if false;
  }
  match /friendRequests/{id}{
   allow get,list: if signedIn() && (resource.data.from==request.auth.uid || resource.data.to==request.auth.uid);
   allow create: if signedIn() && request.resource.data.keys().hasOnly(['from','to','status','createdAt'])
    && request.resource.data.from==request.auth.uid && request.resource.data.to is string
    && request.resource.data.to!=request.auth.uid && request.resource.data.status=='pending';
   allow update: if signedIn() && resource.data.to==request.auth.uid
    && resource.data.status=='pending' && request.resource.data.status in ['accepted','declined']
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
   allow delete: if false;
  }
  match /friendships/{id}{
   allow get,list: if member(resource.data.members);
   allow create: if signedIn() && member(request.resource.data.members)
    && request.resource.data.members.size()==2 && acceptedPair(id);
   allow update,delete: if false;
  }
  match /conversations/{id}{
   allow get,list: if member(resource.data.members);
   allow create: if signedIn() && member(request.resource.data.members)
    && request.resource.data.members.size()==2 && acceptedPair(id);
   allow update: if member(resource.data.members)
    && request.resource.data.members==resource.data.members
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt']);
   allow delete: if false;
   match /messages/{messageId}{
    function parentMembers(){return get(/databases/$(database)/documents/conversations/$(id)).data.members;}
    allow get,list: if member(parentMembers());
    allow create: if member(parentMembers())
     && request.resource.data.keys().hasOnly(['senderId','text','createdAt'])
     && request.resource.data.senderId==request.auth.uid
     && request.resource.data.text is string && request.resource.data.text.size()>0
     && request.resource.data.text.size()<=4000;
    allow update,delete: if false;
   }
  }

  match /calls/{callId} {
   function validPair(data) {
    return data.friendshipId is string
     && exists(/databases/$(database)/documents/friendships/$(data.friendshipId))
     && get(/databases/$(database)/documents/friendships/$(data.friendshipId)).data.members.hasAll(data.participants);
   }
   allow create: if signedIn()
    && request.resource.data.from==request.auth.uid
    && request.resource.data.to is string
    && request.resource.data.to!=request.auth.uid
    && request.resource.data.participants is list
    && request.resource.data.participants.size()==2
    && request.resource.data.participants.hasAll([request.auth.uid,request.resource.data.to])
    && request.resource.data.status=='ringing'
    && validPair(request.resource.data);
   allow get, list: if signedIn() && (request.auth.uid==resource.data.from || request.auth.uid==resource.data.to);
   allow update: if signedIn()
    && request.auth.uid in resource.data.participants
    && request.resource.data.participants==resource.data.participants
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer','status'])
    && request.resource.data.status in ['ringing','active','ended'];
   allow delete: if false;
   match /{candidateSide}/{candidateId} {
    function parentCall(){return get(/databases/$(database)/documents/calls/$(callId)).data;}
    allow get, list: if signedIn() && request.auth.uid in parentCall().participants && candidateSide in ['callerCandidates','calleeCandidates'];
    allow create: if signedIn() && request.auth.uid in parentCall().participants && candidateSide in ['callerCandidates','calleeCandidates'];
    allow update, delete: if false;
   }
  }
  match /phoneIndex/{id}{allow read,write:if false;}
  match /phoneLookupLimits/{id}{allow read,write:if false;}
 }
}